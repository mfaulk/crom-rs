{
  "scenario": "G9",
  "title": "Forged approval",
  "spec": "MILESTONE_18 §13.3",
  "vector": "a random approval_id, an approval for another action, a reused approval, and an approval naming another tenant's supervisor",
  "expected": "approval_invalid; only the refund the application approved executes, once",
  "guard_dependent": true,
  "grant": {
    "tenant": "acme",
    "delegator": {
      "id": "acme-agent-operator",
      "role": "agent-operator",
      "attrs": {
        "refund_limit_cents": {
          "long": 5000
        }
      }
    },
    "run_id": "run-g09",
    "actions": [
      "customer.read",
      "invoice.list",
      "refund.issue"
    ],
    "constraints": {
      "customers": {
        "set": [
          {
            "type": "Support::Customer",
            "id": "acme-cus-000"
          }
        ]
      },
      "max_refund_cents": {
        "at_most": 10000
      }
    },
    "ttl_seconds": 600,
    "max_depth": 0
  },
  "steps": [
    {
      "name": "refund above the limit",
      "tool": "refund.issue",
      "arguments": {
        "invoice_id": "acme-inv-001",
        "amount_cents": 6000
      },
      "bind_digest": "d1",
      "expect": "approval_required"
    },
    {
      "name": "random approval id",
      "attack": true,
      "tool": "refund.issue",
      "arguments": {
        "invoice_id": "acme-inv-001",
        "amount_cents": 6000
      },
      "approval_id": "ap_00000000000000000000000000000000",
      "expect": "approval_invalid",
      "expect_audit": {
        "decision": "deny",
        "reason": "approval_invalid",
        "enforcement": "guard_approval"
      }
    },
    {
      "name": "supervisor approves the 60.00 refund",
      "app": {
        "approve": {
          "digest": "d1",
          "approver": {
            "id": "acme-supervisor",
            "role": "supervisor",
            "attrs": {
              "refund_limit_cents": {
                "long": 100000
              }
            }
          },
          "approver_tenant": "acme",
          "ttl_seconds": 60,
          "bind_approval": "ap1"
        }
      }
    },
    {
      "name": "approval presented for a different amount",
      "attack": true,
      "tool": "refund.issue",
      "arguments": {
        "invoice_id": "acme-inv-001",
        "amount_cents": 7000
      },
      "approval": "ap1",
      "expect": "approval_invalid"
    },
    {
      "name": "approval presented for a different invoice",
      "attack": true,
      "tool": "refund.issue",
      "arguments": {
        "invoice_id": "acme-inv-000",
        "amount_cents": 6000
      },
      "approval": "ap1",
      "expect": "approval_invalid"
    },
    {
      "name": "legit: the approved refund",
      "tool": "refund.issue",
      "arguments": {
        "invoice_id": "acme-inv-001",
        "amount_cents": 6000
      },
      "approval": "ap1",
      "expect": "executed",
      "expect_audit": {
        "decision": "allow",
        "outcome": "executed",
        "approver_role": "supervisor"
      }
    },
    {
      "name": "approval reused",
      "attack": true,
      "tool": "refund.issue",
      "arguments": {
        "invoice_id": "acme-inv-001",
        "amount_cents": 6000
      },
      "approval": "ap1",
      "expect": "approval_invalid"
    },
    {
      "name": "second refund above the limit",
      "tool": "refund.issue",
      "arguments": {
        "invoice_id": "acme-inv-000",
        "amount_cents": 5500
      },
      "bind_digest": "d2",
      "expect": "approval_required"
    },
    {
      "name": "approval names another tenant's supervisor",
      "app": {
        "approve": {
          "digest": "d2",
          "approver": {
            "id": "globex-supervisor",
            "role": "supervisor",
            "attrs": {
              "refund_limit_cents": {
                "long": 100000
              }
            }
          },
          "approver_tenant": "globex",
          "ttl_seconds": 60,
          "bind_approval": "ap2"
        }
      }
    },
    {
      "name": "cross-tenant approval",
      "attack": true,
      "tool": "refund.issue",
      "arguments": {
        "invoice_id": "acme-inv-000",
        "amount_cents": 5500
      },
      "approval": "ap2",
      "expect": "approval_invalid"
    }
  ],
  "expected_ledger_effects": [
    {
      "kind": "refund",
      "tenant": "acme",
      "invoice_id": "acme-inv-001",
      "amount_cents": 6000
    }
  ]
}
