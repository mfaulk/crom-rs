 //! ```text
 //! todo [--file <path>] add <text...>
 //! todo [--file <path>] list
+//! todo [--file <path>] done <id>
 //! ```
 //!
 //! Exit codes: 0 success, 1 runtime error, 2 usage error. Errors are printed
diff --git a/tests/cli_done.rs b/tests/cli_done.rs
new file mode 100644
--- /dev/null
+++ b/tests/cli_done.rs
@@ -0,0 +1,46 @@
+use std::path::PathBuf;
+use std::process::{Command, Output};
+
+fn scratch(name: &str) -> PathBuf {
+    let p = std::env::temp_dir().join(format!("todo-done-{}-{name}.txt", std::process::id()));
+    let _ = std::fs::remove_file(&p);
+    p
+}
+
+fn todo(file: &PathBuf, args: &[&str]) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_todo"))
+        .arg("--file")
+        .arg(file)
+        .args(args)
+        .output()
+        .expect("spawn todo")
+}
+
+#[test]
+fn done_marks_item_complete() {
+    let f = scratch("marks");
+    todo(&f, &["add", "write report"]);
+    let out = todo(&f, &["done", "1"]);
+    assert!(out.status.success());
+    assert_eq!(
+        String::from_utf8_lossy(&out.stdout),
+        "completed 1: write report\n"
+    );
+    let list = todo(&f, &["list"]);
+    assert_eq!(
+        String::from_utf8_lossy(&list.stdout),
+        "[x] 1 write report\n"
+    );
+    let _ = std::fs::remove_file(&f);
+}
+
+#[test]
+fn done_rejects_unknown_id() {
+    let f = scratch("unknown");
+    let out = todo(&f, &["done", "3"]);
+    assert_eq!(out.status.code(), Some(1));
+    assert_eq!(
+        String::from_utf8_lossy(&out.stderr),
+        "error: no item with id 3\n"
+    );
+}
