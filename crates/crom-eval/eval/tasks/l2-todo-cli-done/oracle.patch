+/// `done`: marks item `id` done and prints `completed <id>: <text>`, or
+/// `already completed <id>: <text>` if it was already done.
+pub fn done(path: &Path, id: u32, out: &mut dyn Write) -> Result<(), Failure> {
+    let mut list = load(path)?;
+    let item = list
+        .get_mut(id)
+        .ok_or_else(|| Failure::runtime(format!("no item with id {id}")))?;
+    let prefix = if item.done {
+        "already completed"
+    } else {
+        "completed"
+    };
+    item.done = true;
+    let line = format!("{prefix} {id}: {}", item.text);
+    save(&list, path)?;
+    writeln!(out, "{line}").map_err(|e| Failure::runtime(e.to_string()))
+}
