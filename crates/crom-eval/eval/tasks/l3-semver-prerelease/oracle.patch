     pub fn matches(&self, v: &Version) -> bool {
+        if v.is_prerelease() {
+            let opted_in = self.comparators.iter().any(|c| {
+                c.version.is_prerelease()
+                    && c.version.major == v.major
+                    && c.version.minor == v.minor
+                    && c.version.patch == v.patch
+            });
+            if !opted_in {
+                return false;
+            }
+        }
         self.comparators.iter().all(|c| c.matches_release(v))
     }
 }
