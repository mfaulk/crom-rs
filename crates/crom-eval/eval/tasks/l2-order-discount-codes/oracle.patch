diff --git a/src/pricing.rs b/src/pricing.rs
--- a/src/pricing.rs
+++ b/src/pricing.rs
@@ -4,17 +4,64 @@
 /// Sales tax: 8.00%, expressed in basis points.
 pub const TAX_RATE_BASIS_POINTS: i64 = 800;
 
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum PricingError {
+    UnknownCode(String),
+}
+
+/// A recognised discount code.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum DiscountCode {
+    Save10,
+    Flat5,
+}
+
+impl DiscountCode {
+    pub fn parse(code: &str) -> Result<Self, PricingError> {
+        match code.to_ascii_uppercase().as_str() {
+            "SAVE10" => Ok(Self::Save10),
+            "FLAT5" => Ok(Self::Flat5),
+            _ => Err(PricingError::UnknownCode(code.to_string())),
+        }
+    }
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Save10 => "SAVE10",
+            Self::Flat5 => "FLAT5",
+        }
+    }
+
+    fn amount_cents(self, subtotal: i64) -> i64 {
+        let raw = match self {
+            Self::Save10 => apply_basis_points(subtotal, 1_000),
+            Self::Flat5 => 500,
+        };
+        raw.min(subtotal)
+    }
+}
+
 /// Sum of every line on the order.
 pub fn subtotal_cents(order: &Order) -> i64 {
     order.items().iter().map(|i| i.line_cents()).sum()
 }
 
-/// Tax owed on the order, rounded to the nearest cent (half up).
+/// Discount granted by the order's code (0 when none).
+pub fn discount_cents(order: &Order) -> i64 {
+    order
+        .discount()
+        .map_or(0, |c| c.amount_cents(subtotal_cents(order)))
+}
+
+/// Tax owed on the discounted subtotal, rounded to the nearest cent (half up).
 pub fn tax_cents(order: &Order) -> i64 {
-    apply_basis_points(subtotal_cents(order), TAX_RATE_BASIS_POINTS)
+    apply_basis_points(
+        subtotal_cents(order) - discount_cents(order),
+        TAX_RATE_BASIS_POINTS,
+    )
 }
 
 /// Amount the customer pays.
 pub fn total_cents(order: &Order) -> i64 {
-    subtotal_cents(order) + tax_cents(order)
+    subtotal_cents(order) - discount_cents(order) + tax_cents(order)
 }
