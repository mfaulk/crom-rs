/target
**/target
.agent/
# Agent harness worktrees — transient, never committed.
.claude/worktrees/
# Demos commit their .agent/settings.json so the agent loads expected config.
!examples/*/.agent/
!examples/*/.agent/settings.json
# M6 demos also commit their subagent definitions.
!examples/*/.agent/agents/
!examples/*/.agent/agents/*.md
# M7 demos also commit their Skill and slash-command definitions.
!examples/*/.agent/skills/
!examples/*/.agent/skills/**
!examples/*/.agent/commands/
!examples/*/.agent/commands/**
*.swp
.DS_Store
.env
.env.local

# .worktreeinclude
.env
.env.local