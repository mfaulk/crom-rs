# Copy this file to `.env` and fill in your secrets.
# `.env` is gitignored. Load it before running the CLI, e.g.:
#   set -a && source .env && set +a
#   cargo run -p code-agent-cli -- run "..."

# Required. Obtain from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Overrides the Anthropic API endpoint (default: https://api.anthropic.com).
# Useful for proxies, gateways, or local testing.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional. Standard `tracing-subscriber` filter for CLI logs (default: warn).
# Examples: info, debug, code_agent_core=debug,reqwest=info
# RUST_LOG=info
